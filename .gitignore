.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.lee-llm-router/
*.json
!tests/fixtures/*.json
# Test fixtures live in subdirectories too; the shallow negation above misses them,
# which hid tests/fixtures/staffing/attempt-record-benchmark-v6-run.json from every
# fresh clone and failed 14 tests that pass on a long-lived working tree.
!tests/fixtures/**/*.json
/.venv-linux/

# local harness state / macOS residue (estate sweep 2026-09-04)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
._*
.DS_Store
