  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Record-level provenance: who recorded this unified record and which named sources it cites.",
      "required": ["recorded_by", "source_refs"],
      "properties": {
        "recorded_by": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "description": "References to the named sources that justify this record's fields.",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "description": "Route identity is exactly the tuple (model, effort, harness, channel), per the accepted P0-1 route contract (phase0-contracts §Route; routes.schema.json $defs/route). 'provider' is separate optional observed metadata: it is not part of the identity tuple, is never a replacement for channel, and is null/absent when the source does not observe a provider — never invented. Observed attempt evidence only; never derived from class metadata (D206).",
      "required": ["model", "effort", "harness", "channel"],
      "properties": {
        "model": {
          "description": "Model identifier; part of the route identity tuple.",
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "description": "Model effort dial; part of the route identity tuple. Null only where the harness has no effort dial.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "harness": {
          "description": "Harness identifier; part of the route identity tuple.",
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "description": "Channel identifier; part of the route identity tuple. Must match a channel_id in the channel catalog (cross-catalog check is loader work).",
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "description": "Optional observed provider metadata. Not part of the route identity tuple, never a replacement for channel, and null/absent when the source does not observe a provider.",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "classRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "The strict classes.schema.json $defs/classBlock vocabulary, reproduced verbatim: same six required fields (class_key plus the five components), same closed value sets, same canonical class_key pattern. Per D206, quoted verbatim: 'Class metadata MUST NOT map directly to a preferred model or route. It may only: 1. join production attempts to comparable benchmark evidence; and 2. determine whether an unevidenced cheap trial is permitted.' No class-to-model or class-to-route property exists here and none may be added; the five components are authoritative for validation and class_key is the canonical string rendering (role/oracle_type/domain_tags/size_band/language with tags sorted ascending by codepoint, deduplicated, '+'-joined, and the empty set rendered as the literal 'none', never an empty segment). Cross-field equality between class_key and the components, plus sortedness/dedup of the key segment beyond what the pattern enforces, is loader work (catalog.validate_class_block).",
      "required": [
        "class_key",
        "role",
        "oracle_type",
        "domain_tags",
        "size_band",
        "language"
      ],
      "properties": {
        "class_key": {
          "description": "Canonical key string: role/oracle_type/domain_tags/size_band/language, with the domain-tags segment the literal 'none' for the empty tag set, or one or more tags from the closed set joined by '+' (sortedness and dedup of the segment are loader-enforced). An empty segment (doubled slash) is rejected.",
          "type": "string",
          "pattern": "^(impl|plan|review|judge|prose)/(deterministic|judge|human|none)/(none|(?:persistence|concurrency|security|authority|ui-browser|data-schema|infra-env)(?:\\+(?:persistence|concurrency|security|authority|ui-browser|data-schema|infra-env))*)/(xs|s|m|l)/(python|typescript|shell|c|sql|yaml-config|markdown|mixed)$"
        },
        "role": {
          "description": "Class role; member of the closed role value set.",
          "enum": ["impl", "plan", "review", "judge", "prose"]
        },
        "oracle_type": {
          "description": "Oracle kind for this class; member of the closed oracle_type value set.",
          "enum": ["deterministic", "judge", "human", "none"]
        },
        "domain_tags": {
          "description": "Domain tags; the closed seven-tag vocabulary, unique members, possibly empty. This is the authoritative component for the third key segment.",
          "type": "array",
          "items": {
            "enum": [
              "persistence",
              "concurrency",
              "security",
              "authority",
              "ui-browser",
              "data-schema",
              "infra-env"
            ]
          },
          "uniqueItems": true
        },
        "size_band": {
          "description": "Size band; member of the closed size_band value set.",
          "enum": ["xs", "s", "m", "l"]
        },
        "language": {
          "description": "Primary language; member of the closed language value set.",
          "enum": [
            "python",
            "typescript",
            "shell",
            "c",
            "sql",
            "yaml-config",
            "markdown",
            "mixed"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token usage for the attempt. All five counters are defined; each is a nonnegative integer or null, as source availability requires. usage_capture is exactly the accepted P0-1 contract (routes.schema.json $defs/route.usage_capture): native_json | stream_events | worker_written | none. 'none' means the source captures no usage and every counter is then null (enforced below); no counter is ever estimated or invented.",
      "required": [
        "usage_capture",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "usage_capture": {
          "description": "Exactly one of native_json | stream_events | worker_written | none — the accepted P0-1 usage_capture contract, matching routes.schema.json.",
          "enum": ["native_json", "stream_events", "worker_written", "none"]
        },
        "input_tokens": { "$ref": "#/$defs/tokenCounter" },
        "output_tokens": { "$ref": "#/$defs/tokenCounter" },
        "cached_input_tokens": { "$ref": "#/$defs/tokenCounter" },
        "reasoning_tokens": { "$ref": "#/$defs/tokenCounter" },
        "total_tokens": { "$ref": "#/$defs/tokenCounter" }
      },
      "allOf": [
        {
          "if": {
            "required": ["usage_capture"],
            "properties": { "usage_capture": { "const": "none" } }
          },
          "then": {
            "properties": {
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "cached_input_tokens": { "type": "null" },
              "reasoning_tokens": { "type": "null" },
              "total_tokens": { "type": "null" }
            }
          }
        }
      ]
    },
    "tokenCounter": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cost with its basis. The basis is a required free-form citation (no invented basis categories); amount_usd uses the benchmark money-string shape or null when the source does not price the attempt.",
      "required": ["amount_usd", "basis"],
      "properties": {
        "amount_usd": { "$ref": "#/$defs/money_or_null" },
        "basis": {
          "type": "string",
          "description": "Where the cost number (or its absence) comes from: pricing snapshot, crews file, contract terms entry, or an explicit statement that the source records no price. No invented numbers.",
          "minLength": 1
        },
        "pricing_snapshot_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "pricing_snapshot_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "One lee-llm-router ledger event, exactly the keys in src/lee_llm_router/events.py EVENT_FIELDS, in the shape build_event returns: all seventeen keys are present, with OPTIONAL_FIELDS (ts, host, harness, effort, authorized_by, snapshot_observed_at) filled by the builder and therefore required here, nullable where the builder allows None.",
      "required": [
        "ts",
        "host",
        "harness",
        "crew",
        "role",
        "mode",
        "worker_id",
        "provider",
        "model",
        "effort",
        "channel",
        "headroom",
        "reason",
        "authorized_by",
        "route_id",
        "snapshot_observed_at",
        "snapshot_stale"
      ],
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "crew": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "description": "The resolution modes events.py documents: strict, flex, or bind.",
          "enum": ["strict", "flex", "bind"]
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "headroom": {
          "description": "Funding-headroom judgement wire values from src/lee_llm_router/availability.py Health.",
          "enum": ["healthy", "degraded", "likely_exhausted", "exhausted", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authorized_by": {
          "description": "Only allowed when mode is 'bind' (events.BIND_MODE); build_event raises otherwise. Enforced by the allOf below.",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_observed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "snapshot_stale": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["authorized_by"],
            "properties": { "authorized_by": { "type": "string" } }
          },
          "then": {
            "properties": { "mode": { "const": "bind" } }
          }
        }
      ]
    },
    "agentOrchObservation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Agent-Orch model/effort performance observation, embedded from /home/lee/projects/auto-orch/src/auto_orch/performance.py OBSERVATION_SCHEMA with internal $refs re-scoped to $defs/aoProvenance, $defs/aoParticipant, and $defs/aoSeverityCounts. Shapes are otherwise verbatim.",
      "required": [
        "schema_version",
        "idempotency_key",
        "source",
        "task",
        "producer",
        "reviewer",
        "outcome",
        "review"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "idempotency_key": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
