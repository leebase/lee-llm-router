{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lee-llm-router.local/config/staffing/schema/attempt-record.schema.json",
  "title": "Unified attempt record (Phase 0 P0-9a)",
  "description": "One strict Draft 2020-12 record unifying three observed attempt shapes: the lee-llm-router ledger event (src/lee_llm_router/events.py EVENT_FIELDS), the Agent-Orch model/effort observation (/home/lee/projects/auto-orch/src/auto_orch/performance.py OBSERVATION_SCHEMA), and the AI Workforce Benchmark crew-run record (/home/lee/projects/ai-workforce-benchmark/config/crew-run.schema.json). Each source shape is preserved as its own closed payload; unlike meanings (review verdict vs. benchmark acceptance vs. failure class) are kept distinct. Route identity is exactly the tuple (model, effort, harness, channel) per the accepted P0-1 route contract (phase0-contracts §Route); provider is separate optional observed metadata, never part of the identity tuple, never a replacement for channel, and never invented for a source that lacks one. usage_capture is exactly the accepted P0-1 contract: native_json | stream_events | worker_written | none. class_record reproduces the strict classes.schema.json $defs/classBlock vocabulary verbatim (same six required fields, same closed value sets, same canonical class_key pattern). Per D206, quoted verbatim: 'Class metadata MUST NOT map directly to a preferred model or route. It may only: 1. join production attempts to comparable benchmark evidence; and 2. determine whether an unevidenced cheap trial is permitted.' No class-to-model or class-to-route mapping exists in this schema. verified_success is true only when all required evidence is genuinely present; where a source lacks a channel, provider, supervisor route, usage, cost, or duration, the field is null or absent — never invented. Every price, fee, capacity, date, or multiplier needs a source; this schema invents none.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "record_kind",
    "captured_at",
    "verified_success",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attempt_id": {
      "type": "string",
      "description": "Caller-supplied attempt identifier. Pattern taken verbatim from the benchmark crew-run attempt_id; a real Agent-Orch attempt id (e.g. a6a85c6b02c6) matches it.",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "minLength": 1
    },
    "record_kind": {
      "type": "string",
      "description": "Which source produced the attempt. The matching source payload is required (see allOf). An interactive router event is a dispatch event: it records no verdict, so its verified_success is always false and no verdict may be asserted for it.",
      "enum": ["agent_orch", "benchmark_run", "interactive"]
    },
    "captured_at": {
      "type": "string",
      "description": "When the record was captured, aware UTC date-time (analogous to events.py ts and crew-run provenance.assembled_at).",
      "format": "date-time"
    },
    "verified_success": {
      "type": "boolean",
      "description": "True only when the attempt's success is verified by its source AND every required evidence field (route, supervisor_route, class_record including class_key and oracle_type, verdict, failure_class=null, usage with all five non-null token counters and a valid usage_capture, cost with non-null amount_usd and nonempty basis, and wall_clock_ms) is genuinely present. A source that reports success without complete evidence yields verified_success false — missing evidence is never invented to reach true. Sources lacking any required evidence remain false; provider is optional observed metadata and is never invented."
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "supervisor_route": {
      "description": "Supervisor route of the attempt, present only when the source records one (named-crew contract: a named crew carries a supervisor route). Null or absent when the source records no supervisor route; never invented. Null is the explicit 'the source records no supervisor route' marker.",
      "anyOf": [
        { "$ref": "#/$defs/route" },
        { "type": "null" }
      ]
    },
    "class_record": {
      "$ref": "#/$defs/classRecord"
    },
    "verdict": {
      "type": "string",
      "description": "Source-specific outcome vocabulary, deliberately NOT unified semantically: 'pass'/'fail' come from the Agent-Orch review final_verdict; 'accepted'/'not_accepted'/'unverified' come from the benchmark crew-run acceptance enum. These words do not mean the same thing across sources; consumers must branch on record_kind. Forbidden entirely on interactive records, whose router event records no verdict.",
      "enum": ["pass", "fail", "accepted", "not_accepted", "unverified"]
    },
    "failure_class": {
      "description": "Failure taxonomy. Exactly five values are proven by the P0-9a task contract (platform_timeout, platform_env, spec_rejected, capability_rejected, unaccounted_spend); no named source proves others, so none are added. Null means no failure recorded (required to be null when verified_success is true).",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "platform_timeout",
            "platform_env",
            "spec_rejected",
            "capability_rejected",
            "unaccounted_spend"
          ]
        },
        { "type": "null" }
      ]
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "wall_clock_ms": {
      "type": ["integer", "null"],
      "description": "Observed wall-clock duration in milliseconds, or null when the source does not record one (Agent-Orch observations and router events carry none; benchmark stages/totals carry elapsed_ms). Never estimated or invented.",
      "minimum": 0
    },
    "router_event": {
      "$ref": "#/$defs/eventRecord"
    },
    "agent_orch_observation": {
      "$ref": "#/$defs/agentOrchObservation"
    },
    "benchmark_run": {
      "$ref": "#/$defs/crewRunRecord"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["verified_success"],
        "properties": { "verified_success": { "const": true } }
      },
      "then": {
        "required": [
          "route",
          "supervisor_route",
          "class_record",
          "verdict",
          "failure_class",
          "usage",
          "cost",
          "wall_clock_ms"
        ],
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "supervisor_route": { "$ref": "#/$defs/route" },
          "failure_class": { "type": "null" },
          "verdict": { "enum": ["pass", "accepted"] },
          "usage": {
            "allOf": [
              { "$ref": "#/$defs/usage" },
              {
                "required": [
                  "usage_capture",
                  "input_tokens",
                  "output_tokens",
                  "cached_input_tokens",
                  "reasoning_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "usage_capture": {
                    "enum": ["native_json", "stream_events", "worker_written", "none"]
                  },
                  "input_tokens": { "type": "integer", "minimum": 0 },
                  "output_tokens": { "type": "integer", "minimum": 0 },
                  "cached_input_tokens": { "type": "integer", "minimum": 0 },
                  "reasoning_tokens": { "type": "integer", "minimum": 0 },
                  "total_tokens": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          },
          "cost": {
            "allOf": [
              { "$ref": "#/$defs/cost" },
              {
                "required": ["amount_usd", "basis"],
                "properties": {
                  "amount_usd": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "basis": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "wall_clock_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": {
        "required": ["record_kind"],
        "properties": { "record_kind": { "const": "agent_orch" } }
      },
      "then": { "required": ["agent_orch_observation"] }
    },
    {
      "if": {
        "required": ["record_kind"],
        "properties": { "record_kind": { "const": "benchmark_run" } }
      },
      "then": { "required": ["benchmark_run"] }
    },
    {
      "if": {
        "required": ["record_kind"],
        "properties": { "record_kind": { "const": "interactive" } }
      },
      "then": {
        "required": ["router_event"],
        "properties": {
          "verified_success": { "const": false },
          "verdict": false
        }
      }
    }
  ],
