          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "crewStage": {
      "type": "object",
