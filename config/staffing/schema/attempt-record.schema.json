            "cycle_id": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "producer_step_id": { "type": "string", "minLength": 1 },
            "producer_attempt": { "type": "integer", "minimum": 1 },
            "review_step_id": { "type": "string", "minLength": 1 },
            "review_attempt": { "type": "integer", "minimum": 1 }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backlog_title", "producer_role", "reviewer_role"],
          "properties": {
            "backlog_title": { "type": ["string", "null"] },
            "producer_role": { "type": ["string", "null"] },
            "reviewer_role": { "type": ["string", "null"] }
          }
        },
        "producer": { "$ref": "#/$defs/aoParticipant" },
        "reviewer": { "$ref": "#/$defs/aoParticipant" },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_status",
            "run_passed",
            "cycle_outcome",
            "final_completion"
          ],
          "properties": {
            "run_status": { "type": "string", "minLength": 1 },
            "run_passed": { "type": "boolean" },
            "cycle_outcome": { "type": "string", "minLength": 1 },
            "final_completion": { "type": "boolean" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "final_verdict",
            "first_review_clean",
            "severity_threshold",
            "severity_counts",
            "finding_count",
            "blocking_finding_count",
            "review_cycles",
            "repair_cycles",
            "artifact_sha256s"
          ],
          "properties": {
            "final_verdict": { "enum": ["pass", "fail"] },
            "first_review_clean": { "type": "boolean" },
            "severity_threshold": { "enum": ["Low", "Medium", "High", "Critical"] },
            "severity_counts": { "$ref": "#/$defs/aoSeverityCounts" },
            "finding_count": { "type": "integer", "minimum": 0 },
            "blocking_finding_count": { "type": "integer", "minimum": 0 },
            "review_cycles": { "type": "integer", "minimum": 1 },
            "repair_cycles": { "type": "integer", "minimum": 0 },
            "artifact_sha256s": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "aoParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "executed", "executed_attested"],
